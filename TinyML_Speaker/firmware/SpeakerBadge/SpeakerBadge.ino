// Standalone Nano 33 BLE Sense Rev2 firmware. Model header is generated by train.
#include <ArduinoBLE.h>
#include <Arduino_BMI270_BMM150.h>
#include <Arduino_HS300x.h>
#include <Arduino_LPS22HB.h>
#include <Arduino_APDS9960.h>
#include <PDM.h>
#include "Detector.h"
#if __has_include("model.h")
#include "model.h"
#define HAS_MODEL 1
#else
#define HAS_MODEL 0
#define SPEAKER_MODEL_ID "paper-rule"
#endif

BLEService service("e8310001-65d2-4b11-91e0-87f64f931c82");
BLECharacteristic readings("e8310002-65d2-4b11-91e0-87f64f931c82", BLERead | BLENotify, 20);
PaperDetector detector;
short audio[256];
volatile float soundPower = 0;
volatile uint32_t audioTime = 0;
uint32_t previousSample = 0, slowTime = 0, sequence = 0, lateSamples = 0;
float oldX = 0, oldY = 0, oldZ = 0;
bool firstMotion = true;
float temperature = NAN, humidity = NAN, pressure = NAN, proximity = NAN;
bool hasHS, hasBARO, hasAPDS;

void audioReceived() {
  int bytes = min(PDM.available(), static_cast<int>(sizeof(audio)));
  if (bytes <= 0) return;
  PDM.read(audio, bytes);
  int n = bytes / sizeof(short);
  uint64_t sum = 0;
  for (int i = 0; i < n; ++i) {
    int32_t sample = audio[i];
    sum += static_cast<uint64_t>(sample * sample);
  }
  // Legacy firmware divided full-block sum by 512 rather than 256.
  soundPower = n ? static_cast<float>(sum) / (2 * n) : 0;
  audioTime = millis();
}

void sendLine(const char *line) {
  if (!BLE.connected() || !readings.subscribed()) return;
  for (size_t offset = 0; offset < strlen(line); offset += 20) {
    readings.writeValue(reinterpret_cast<const uint8_t *>(line + offset),
                       static_cast<int>(min(static_cast<size_t>(20), strlen(line) - offset)));
    BLE.poll();
  }
}

void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  if (!IMU.begin() || !BLE.begin()) {
    while (true) { digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); delay(200); }
  }
  hasHS = HS300x.begin();
  hasBARO = BARO.begin();
  hasAPDS = APDS.begin();
  BLE.setLocalName("SCI Speaker v1");
  BLE.setAdvertisedService(service);
  service.addCharacteristic(readings);
  BLE.addService(service);
  PDM.onReceive(audioReceived);
  if (!PDM.begin(1, 16000)) {
    while (true) { digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); delay(500); }
  }
  BLE.advertise();
}

void loop() {
  BLE.poll();
  uint32_t now = millis();
  if (now - previousSample < 100) return;
  bool gap = previousSample && now - previousSample > 250;
  if (now - previousSample >= 200) lateSamples += (now - previousSample) / 100 - 1;
  previousSample = now;
  ++sequence;
  if (gap || now - audioTime > 100 || !IMU.accelerationAvailable() || !IMU.gyroscopeAvailable()) {
    detector.reset();
    firstMotion = true;
    return;
  }
  float x, y, z, gx, gy, gz, mx = NAN, my = NAN, mz = NAN;
  IMU.readAcceleration(x, y, z);
  IMU.readGyroscope(gx, gy, gz);
  if (IMU.magneticFieldAvailable()) IMU.readMagneticField(mx, my, mz);
  // Keep last valid magnetometer magnitude because it updates more slowly.
  static float magnetic = NAN;
  if (isfinite(mx)) magnetic = sqrtf(mx * mx + my * my + mz * mz);
  float accel = firstMotion ? 0 : fabsf(x - oldX) + fabsf(y - oldY) + fabsf(z - oldZ);
  firstMotion = false;
  oldX = x; oldY = y; oldZ = z;
  float gyro = sqrtf(gx * gx + gy * gy + gz * gz);
  if (!slowTime || now - slowTime >= 1000) {
    slowTime = now;
    if (hasHS) { temperature = HS300x.readTemperature(); humidity = HS300x.readHumidity(); }
    if (hasBARO) pressure = BARO.readPressure();
  }
  if (hasAPDS && APDS.proximityAvailable()) proximity = APDS.readProximity();
  float sound = soundPower;
  Detection result = detector.update(sound, accel);
  float features[] = {result.sound, result.accel, result.margin, gyro, magnetic,
                      temperature, humidity, pressure, proximity};
  bool complete = result.ready;
  for (float value : features) complete = complete && isfinite(value);
  float modelScore = -1;
  bool candidate = result.candidate;
#if HAS_MODEL
  if (complete) {
    modelScore = wearerModel(features);
    candidate = modelScore >= .6f;
  } else {
    // A deployed hybrid model never falls back silently when sensors fail.
    candidate = false;
  }
#endif
  // Missing auxiliary sensors use -1 in transport; training rejects them.
  for (int i = 3; i < 9; ++i) if (!isfinite(features[i])) features[i] = -1;
  char identity[64];
  snprintf(identity, sizeof(identity), "M,%s\n", SPEAKER_MODEL_ID);
  if (sequence % 10 == 0) sendLine(identity);
  char line[300];
  snprintf(line, sizeof(line),
           "S,%lu,%lu,%.3f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%d,%d,%d,%.4f,%.4f,%.3f,%.3f,%.4f,%.0f,%lu\n",
           static_cast<unsigned long>(sequence), static_cast<unsigned long>(now), sound, accel,
           result.sound, result.accel, result.margin, result.score, modelScore,
           result.ready, result.candidate, candidate, features[3], features[4],
           features[5], features[6], features[7], features[8], static_cast<unsigned long>(lateSamples));
  sendLine(line);
  digitalWrite(LED_BUILTIN, candidate);
}
